{
  "name": "proofline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/train.mjs && node scripts/setup.mjs",
    "train": "node scripts/train.mjs",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test": "node --test --test-force-exit --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "ethers": "6.15.0",
    "express": "5.1.0",
    "ganache": "7.9.2",
    "lucide-react": "0.468.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "snarkjs": "0.7.5",
    "solc": "0.8.30"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "6.4.1"
  }
}
